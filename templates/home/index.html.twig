                  <div class="stage" style="--k:0"><span class="mono">Commit</span><b>Git</b></div>
                  <div class="stage" style="--k:1"><span class="mono">Build · Test</span><b>Jenkins</b></div>
                  <div class="stage" style="--k:2"><span class="mono">Image</span><b>Docker</b></div>
                  <div class="stage" style="--k:3"><span class="mono">Sync</span><b>Argo CD</b></div>
                  <div class="stage" style="--k:4"><span class="mono">Run</span><b>K8s</b></div>
