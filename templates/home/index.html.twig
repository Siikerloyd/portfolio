                  <p style="--k:0"><b class="lime">✓</b> git push origin main</p>
                  <p style="--k:1"><b class="lime">✓</b> jenkins · jest + cypress passed</p>
                  <p style="--k:2"><b class="lime">✓</b> docker · image built</p>
                  <p style="--k:3"><b class="lime">✓</b> argo cd · synced from git</p>
                  <p style="--k:4"><b class="lime">✓</b> kubernetes · rollout on minikube</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

    </div>

    <div class="sub-head">
      <h3 class="display"><span></span>Infrastructure labs</h3>
      <span class="count mono">03 labs</span>
    </div>

    <div class="labs">
      {% for l in labs %}
      <article class="mini" id="lab-{{ l.no|lower }}" data-r style="--d:{{ loop.index0 * 80 }}ms">
        <div class="mini-k"><span class="mini-no" aria-hidden="true">{{ l.no }}</span><span class="mono">Lab</span></div>
        <h4 class="display">{{ l.title }}</h4>
        <p class="mini-cmd mono">{{ l.cmd }}<i class="caret"></i></p>
        <p>{{ l.text }}</p>
        <ul class="tech" aria-label="Technologies">{% for t in l.tags %}<li>{{ t }}</li>{% endfor %}</ul>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ───────── 02 Experience ───────── #}
<section class="sec experience" id="experience" aria-labelledby="experience-h">
  <div class="wrap">
    <header class="sec-head">
      <p class="mono sec-k"><span class="lime">02</span> / Experience</p>
      <h2 class="sec-title display" id="experience-h" data-split>Hands-on <em>experience.</em></h2>
      <p class="sec-sub">Five placements across network engineering, DevOps, backend development, monitoring and system administration. Most recent first.</p>
      <i class="rule"></i>
    </header>

    <ol class="xp">
      {% for x in experience %}
      <li class="xp-row" id="xp-{{ loop.index }}" data-r>
        <div class="xp-when">
          <span class="xp-yr">{{ x.year }}</span>
          <span class="mono">{{ x.kind }}</span>
        </div>
        <div class="xp-rail" aria-hidden="true"><i></i></div>
        <div class="xp-main">
          <div class="xp-top">
            <h3 class="xp-org display">{{ x.org }}</h3>
            <span class="xp-idx mono">{{ '%02d'|format(loop.index) }} / {{ '%02d'|format(experience|length) }}</span>
          </div>
          <p class="mono lime xp-focus">{{ x.focus }}</p>
          <ul class="xp-list">
            {% for b in x.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          <ul class="tech xp-tags" aria-label="Technologies">
            {% for t in x.tags %}<li>{{ t }}</li>{% endfor %}
          </ul>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ───────── 03 Skills ───────── #}
<section class="sec tools" id="skills" aria-labelledby="skills-h">
  <div class="wrap">
    <header class="sec-head">
      <p class="mono sec-k"><span class="lime">03</span> / Skills</p>
      <h2 class="sec-title display" id="skills-h" data-split>Technical <em>skills.</em></h2>
      <p class="sec-sub">Grouped by area. Pick a category, then hover a tool to see where I used it.</p>
      <i class="rule"></i>
    </header>

    <div class="tools-g">
      <div class="tabs">
        {% for s in skills %}
        <button class="tab{% if loop.first %} on{% endif %}" type="button" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}" data-cmd="{{ s.cmd }}"><span class="mono">{{ '%02d'|format(loop.index) }}</span><span class="tab-t display">{{ s.title }}</span><span class="tab-c mono">{{ '%02d'|format(s['items']|length) }}</span></button>
        {% endfor %}
      </div>

      <div class="term" data-r>
        <div class="vbar"><i></i><i></i><i></i><span class="mono">siiker@tunis: ~/skills</span></div>
        <div class="term-body">
          <p class="prompt mono"><span class="lime">$</span> <span data-cmd>{{ skills[0].cmd }}</span></p>

          {% for s in skills %}
          <div class="pane{% if loop.first %} on{% endif %}">
            {% for it in s['items'] %}<button class="chip" type="button" data-n="{{ it[1] }}">{{ it[0] }}</button>{% endfor %}
          </div>
          {% endfor %}

          <p class="readout mono" aria-live="polite"><span class="lime">›</span> <span id="readtxt">Hover a tool to see where it was used.</span><i class="caret"></i></p>
        </div>
      </div>
    </div>

    <div class="skillmap">
      <div class="sub-head first">
        <h3 class="display"><span></span>Skill map</h3>
        <span class="count mono" data-graph-count>32 tools</span>
      </div>
      <p class="sec-sub">Pick a tool to see where I used it, or pick a project or placement to see what it used. Matching tags light up across the page.</p>

      <div class="graph" data-r>
        <div class="g-tools" role="group" aria-label="Tools">
          {% for grp in graphTools %}
          <div class="g-group">
            <span class="g-cat mono">{{ grp.g }}</span>
            {% for tl in grp['items'] %}<button class="g-tool" type="button" aria-pressed="false" data-tool="{{ tl }}">{{ tl }}</button>{% endfor %}
          </div>
          {% endfor %}
        </div>

        <div class="g-ents" role="group" aria-label="Projects and placements">
          {% for e in entities %}
          <button class="g-ent" type="button" aria-pressed="false" data-uses="{{ e.tools|join('|') }}" data-proj="{{ e.proj }}" data-exp="{{ e.exp }}">
            <span class="g-e-n mono">{{ '%02d'|format(loop.index) }}</span>
            <b class="display">{{ e.name }}</b>
            <span class="g-e-c mono">{{ e.tools|length }} tools</span>
            <span class="g-e-m mono">{{ e.meta }}</span>
          </button>
          {% endfor %}
        </div>
      </div>

      <div class="g-info" aria-live="polite">
        <span class="g-msg">Pick a tool or an entry to see how they connect.</span>
        <button class="g-clear mono" type="button" hidden>Clear ✕</button>
      </div>
    </div>
  </div>
</section>

{# ───────── 04 About ───────── #}
