<!DOCTYPE html>
<html lang="en" data-motion="full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0E100D">
    <title>{% block title %}SIIKER — Networks, DevOps &amp; Full-stack{% endblock %}</title>
    <meta name="description" content="SIIKER: portfolio of Ben Lagha Mohamed, engineering student in Tunis. Networks, systems, DevOps and full-stack development.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
    {# Runs before first paint.
       - "mo" class  = motion ON. Every hidden/animated start state in the CSS is gated on it.
       - Mode comes from the visitor's saved choice (header toggle); the default is ON.
       - If the main script has not started after 4s, "mo" is removed so nothing can stay hidden. #}
    <script>
    (function () {
        var d = document.documentElement, m = null;
        d.classList.add('js');
        try { m = localStorage.getItem('siiker-motion'); } catch (e) {}
        if (m !== 'full' && m !== 'calm') { m = 'full'; }
        d.setAttribute('data-motion', m);
        if (m === 'full') { d.classList.add('mo'); }
        setTimeout(function () {
            if (!window.__siiker) { d.classList.remove('mo'); d.classList.add('nojs'); }
        }, 4000);
    })();
    </script>
    {% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/siiker.css') }}?v=8">{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"><i></i></div>
<div class="grain" aria-hidden="true"></div>
{% block body %}{% endblock %}
{% block javascripts %}<script src="{{ asset('js/siiker.js') }}?v=8" defer></script>{% endblock %}
</body>
</html>
